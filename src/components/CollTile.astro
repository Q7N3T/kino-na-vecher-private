---
// Плитка подборки: название, подпись и стопка из трёх постеров — что внутри, а не сколько.
import { collection } from '../lib/data.js';
import { tmdbImg, hue } from '../lib/format.js';
interface Props { c: { slug: string; title: string; sub: string; hue: number } }
const { c } = Astro.props;
const base = import.meta.env.BASE_URL;
const top = collection(c, 30).filter((f) => f.p).slice(0, 3);
---
<a class="coll" href={`${base}podborki/${c.slug}/`} style={`--h:${c.hue}`}>
  <span class="stack" aria-hidden="true">
    {top.map((f, i) => <span class="st-p" style={`--k:${i};--h:${hue(f.id)}`}><img src={tmdbImg(f.p, 120)} alt="" loading="lazy" onerror="knvImg(this)" /></span>)}
  </span>
  <b>{c.title}</b><span>{c.sub}</span>
</a>
<style>
  .coll { position: relative; justify-content: flex-start; gap: 4px; min-height: 0; }
  .stack { display: block; position: relative; height: 88px; margin-bottom: 16px; }
  .st-p { position: absolute; top: 0; left: calc(var(--k) * 36px); width: 56px; aspect-ratio: 2 / 3; border-radius: 8px; overflow: hidden;
    background: hsl(var(--h) 26% 26%); box-shadow: 0 8px 24px -8px rgba(0, 0, 0, .8); transform: rotate(calc((var(--k) - 1) * 6deg));
    transition: transform 500ms var(--ease); }
  .st-p img { width: 100%; height: 100%; object-fit: cover; }
  .coll:hover .st-p { transform: rotate(calc((var(--k) - 1) * 10deg)) translateX(calc((var(--k) - 1) * 4px)); }
</style>
