---
import Base from '../layouts/Base.astro';
import { similar } from '../lib/data.js';
import { sticker } from '../lib/stickers.js';
import { cardHTML, MOODS, status, years, kindName, dur, plural, num, votes, tmdbImg, hue, initials } from '../lib/format.js';
import { watchLink, searchLinks } from '../lib/partners.js';

const { f } = Astro.props;
const base = import.meta.env.BASE_URL;
const st = status(f);
const sim = similar(f, 6);
const total = f.k && f.ep ? f.ep * f.min : 0;
const section = f.k ? 'serialy/' : 'filmy/';
const desc = f.syn ? f.syn.slice(0, 180).replace(/\s+\S*$/, '') + '…' : `${kindName(f)} ${years(f)}. Рейтинг IMDb ${f.imdb.toFixed(1)}.`;
const yt = 'https://www.youtube.com/results?search_query=' + encodeURIComponent(`${f.o || f.t} ${f.y} трейлер`);
// где посмотреть: подписка, бесплатно, с рекламой, аренда, покупка (данные JustWatch через TMDB)
const WATCH = [['s', 'По подписке'], ['f', 'Бесплатно'], ['a', 'Бесплатно с рекламой'], ['r', 'Аренда'], ['b', 'Покупка']];
const watchGroups = f.wp ? WATCH.filter(([k]) => f.wp[k]?.length).map(([k, label]) => ({ label, items: f.wp[k] })) : [];
// две строки фактов вместо чипов и таблицы
const facts = [kindName(f), f.genres.slice(0, 3).join(', '), years(f),
  f.k ? [f.ss && `${f.ss} ${plural(f.ss, 'сезон', 'сезона', 'сезонов')}`, f.ep && `${num(f.ep)} ${plural(f.ep, 'серия', 'серии', 'серий')}`].filter(Boolean).join(', ') : dur(f.min),
  st && (st.label.toLowerCase() + (st.more && !st.on ? ' ' + st.more : ''))].filter(Boolean);
const score = [`IMDb ${f.imdb.toFixed(1)}`, `${votes(f.v)} ${plural(f.v, 'оценка', 'оценки', 'оценок')}`,
  f.k && `серия ${dur(f.min)}`, total && `весь сериал ≈ ${Math.round(total / 60)} ч`, f.d?.length && `${f.d.length > 1 ? 'режиссёры' : 'режиссёр'} ${f.d.join(', ')}`].filter(Boolean);
// главная кнопка — смотреть сразу, если есть где; иначе — «Смотрю сегодня»
const nowKind = f.wp && ['s', 'f', 'a'].find((k) => f.wp[k]?.length);
const go = nowKind && { pid: f.wp[nowKind][0][0], name: f.wp[nowKind][0][1], free: nowKind !== 's' };
// поискать в кинотеатрах, которых нет в «Где посмотреть» (у двух третей тайтлов данных JustWatch нет вовсе)
const elsewhere = searchLinks(f, watchGroups.flatMap((g) => g.items.map(([pid]) => pid)));
const jsonld = {
  '@context': 'https://schema.org', '@type': f.k ? 'TVSeries' : 'Movie', name: f.t, alternateName: f.o, datePublished: String(f.y),
  genre: f.genres, description: f.syn || undefined, image: f.p ? `https://image.tmdb.org/t/p/w500${f.p}` : undefined,
  aggregateRating: { '@type': 'AggregateRating', ratingValue: f.imdb, ratingCount: f.v, bestRating: 10, worstRating: 1 },
  actor: f.crew.slice(0, 6).map((c) => ({ '@type': 'Person', name: c.n })),
};
---
<Base title={`${f.t} (${years(f)})`} description={desc} section={section} image={f.p ? tmdbImg(f.p, 500) : undefined}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonld)} />
  <section class="hero-t" style={`--h:${hue(f.id)}`}>
    <!-- фон шапки — тот же постер, размытый в свет: заполняет ширину, как у Apple TV -->
    {f.p && <img class="t-bg" src={tmdbImg(f.p, 342)} alt="" aria-hidden="true" onerror="knvImg(this)" />}
    <div class="wrap">
      <nav class="crumbs" aria-label="Навигация"><a href={base}>Главная</a> / <a href={base + section}>{f.k ? 'Сериалы' : 'Фильмы'}</a> / <span>{f.t}</span></nav>
      <div class="t-row">
        <div class="poster t-poster">
          {f.p && <img src={tmdbImg(f.p, 500)} alt={`Постер: «${f.t}»`} onerror="knvImg(this)" />}
          <span class="ph" aria-hidden="true">{f.t}</span>
        </div>
        <div class="t-info">
          <div>
            <h1>{f.t}</h1>
            {f.o && <p class="t-orig">{f.o}</p>}
          </div>
          <div class="facts">
            <p>{facts.join(' · ')}</p>
            <p>{score.join(' · ')}{st?.on && st.more ? ` · ${st.more}` : ''}</p>
          </div>
          {f.m.length > 0 && <ul class="moods-l" aria-label="Настроение">{f.m.map((m) => <li><Fragment set:html={sticker(m)} />{MOODS.find((x) => x.v === m)?.tag}</li>)}</ul>}
          <p class="clock">{f.k ? 'Первая серия закончится в' : 'Закончится в'} <b data-end={f.min}></b>, если начать сейчас</p>
          <div class="acts">
            {go
              ? <a class="btn" id="tonight" data-id={f.id} href={watchLink(f, go.pid)} rel="noopener sponsored" target="_blank" data-umami-event="Где посмотреть" data-umami-event-provider={go.name} data-umami-event-type="главная кнопка" data-umami-event-title={f.t}>{go.free ? `Смотреть бесплатно в ${go.name}` : `Смотреть в ${go.name}`}</a>
              : <button class="btn" id="tonight" data-id={f.id} data-umami-event="Смотрю сегодня" data-umami-event-title={f.t}>Смотрю сегодня</button>}
            <button class="btn ghost" id="watch" data-id={f.id} aria-pressed="false" data-umami-event="В мой список" data-umami-event-title={f.t}>
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M6 3h12v18l-6-4-6 4z"></path></svg><span>В мой список</span></button>
            <a class="btn ghost" href={yt} rel="noopener" target="_blank" data-umami-event="Трейлер" data-umami-event-title={f.t}><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M7 4v16l13-8z"></path></svg>Трейлер</a>
          </div>
          {f.syn && <p class="syn">{f.syn}</p>}
          <p class="elsewhere">{watchGroups.length ? 'Поискать ещё в' : 'Поискать в кинотеатрах'}: {elsewhere.map((l, i) => <>{i > 0 && ' · '}<a href={l.url} rel="noopener" target="_blank" data-umami-event="Поискать в кинотеатре" data-umami-event-provider={l.name} data-umami-event-title={f.t}>{l.name}</a></>)}</p>
          <p class="more">Подробнее: <a href={`https://www.imdb.com/title/${f.id}/`} rel="noopener" target="_blank">IMDb ↗</a> · <a href={`https://www.themoviedb.org/redirect?external_source=imdb_id&external_id=${f.id}`} rel="noopener" target="_blank">TMDB ↗</a></p>
          {watchGroups.length > 0 && !(go && watchGroups.length === 1 && watchGroups[0].items.length === 1) && ( /* один кинотеатр — уже на главной кнопке */
            <section class="where" aria-labelledby="h-where">
              <h2 id="h-where">Где посмотреть</h2>
              {watchGroups.map((g) => (
                <div class="where-row">
                  <span class="where-k">{g.label}</span>
                  <ul>
                    {g.items.map(([pid, name, logo]) => (
                      <li><a href={watchLink(f, pid)} rel="noopener sponsored" target="_blank"
                        data-umami-event="Где посмотреть" data-umami-event-provider={name} data-umami-event-type={g.label} data-umami-event-title={f.t}>
                        {logo && <img src={tmdbImg(logo, 64, 'w92')} alt="" width="28" height="28" loading="lazy" onerror="knvImg(this)" />}
                        <span>{name}</span>
                      </a></li>
                    ))}
                  </ul>
                </div>
              ))}
              <p class="where-src">Легальные онлайн-кинотеатры в России. Данные — <a href="https://www.justwatch.com" rel="noopener" target="_blank">JustWatch</a>.</p>
            </section>
          )}
        </div>
      </div>
    </div>
  </section>

  <div class="wrap t-body">
    <div class="t-main">
      {f.crew.length > 0 && (
        <section>
          <h2>В ролях</h2>
          <ul class="cast">
            {f.crew.map((c) => {
              const inner = <>
                <span class="face" style={`--h:${hue(c.n)}`}>{c.p && <img src={tmdbImg(c.p, 160, 'w185')} alt="" loading="lazy" onerror="knvImg(this)" />}<b aria-hidden="true">{initials(c.n)}</b></span>
                <span class="who"><span>{c.n}</span>{c.r && <small>{c.r}</small>}</span>
              </>;
              return <li>{c.slug ? <a href={`${base}akter/${c.slug}/`}>{inner}</a> : <div>{inner}</div>}</li>;
            })}
          </ul>
        </section>
      )}
      {f.k && f.sx.length > 0 && (
        <section>
          <h2>Сезоны</h2>
          <ol class="seasons">
            {f.sx.map(([n, eps, y1, y2]) => <li><span>Сезон {n}</span><small>{[y1 && (y2 && y2 !== y1 ? `${y1}–${y2}` : y1), `${eps} ${plural(eps, 'серия', 'серии', 'серий')}`].filter(Boolean).join(' · ')}</small></li>)}
            {f.ann ? <li class="soon"><span>{f.ann > 1 ? `Сезоны ${f.ss + 1}–${f.ss + f.ann}` : `Сезон ${f.ss + 1}`}</span><small>анонсированы</small></li> : null}
          </ol>
        </section>
      )}
    </div>
  </div>

  {sim.length > 0 && (
    <section class="sec wrap" aria-labelledby="h-sim">
      <div class="sec-h"><h2 id="h-sim">Похожее</h2></div>
      <div class="grid row" set:html={sim.map((x, i) => cardHTML(x, base, { i })).join('')}></div>
    </section>
  )}
</Base>

<style>
  .hero-t { position: relative; overflow: hidden; isolation: isolate; }
  .t-bg { position: absolute; left: -10%; top: -10%; z-index: -1; width: 120%; max-width: none; height: 110%; object-fit: cover; /* низ — ровно по низу шапки, там и затухает */ filter: blur(64px) saturate(1.3); opacity: .28;
    -webkit-mask-image: linear-gradient(to bottom, #000 40%, transparent); mask-image: linear-gradient(to bottom, #000 40%, transparent); }
  .hero-t .wrap { padding-top: 24px; padding-bottom: 48px; }
  .t-row { display: flex; flex-wrap: wrap; gap: 40px 48px; align-items: flex-start; }
  .t-poster { flex: 0 1 320px; min-width: 220px; margin: 0; border-radius: 16px; box-shadow: 0 40px 80px -30px rgba(0, 0, 0, .9); animation: rise 700ms var(--ease) both; }
  .t-poster .ph { font-size: 20px; padding: 24px; }
  .t-info { flex: 999 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 24px; padding-top: 8px; }
  .t-info > * { animation: rise 600ms var(--ease) both; }
  .t-info > :nth-child(2) { animation-delay: 50ms; } .t-info > :nth-child(3) { animation-delay: 100ms; } .t-info > :nth-child(4) { animation-delay: 150ms; } .t-info > :nth-child(5) { animation-delay: 200ms; }
  h1 { margin: 0; font-size: 60px; font-weight: 700; line-height: 1; letter-spacing: -.025em; }
  .t-orig { margin: 8px 0 0; font-size: 18px; line-height: 28px; color: var(--dim); }
  .facts { display: flex; flex-direction: column; gap: 4px; max-width: 720px; }
  .facts p { margin: 0; font-size: 16px; line-height: 24px; color: var(--muted); }
  .facts p + p { color: var(--dim); font-size: 14px; line-height: 20px; }
  .moods-l { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 16px; }
  .moods-l li { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; line-height: 20px; color: var(--muted); }
  .clock { margin: 0; font-size: 18px; line-height: 28px; color: var(--muted); }
  .clock b { color: var(--accent); font-weight: 600; }
  .clock:has(> b:empty) { visibility: hidden; } /* время ещё не посчитано */
  .acts { display: flex; flex-wrap: wrap; gap: 12px; }
  .where { max-width: 720px; padding: 18px 20px; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); display: grid; gap: 12px; }
  .where h2 { margin: 0; font-size: 17px; font-weight: 600; }
  .where-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; }
  .where-k { font-size: 13px; color: var(--dim); min-width: 92px; }
  .where ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .where li a { display: inline-flex; align-items: center; gap: 8px; height: 40px; padding: 0 14px 0 6px; border-radius: 999px; background: var(--surface-2); border: 1px solid var(--line-2); color: var(--text); text-decoration: none; font-size: 14px; font-weight: 500; transition: border-color .2s; }
  .where li a:hover { border-color: var(--accent); }
  .where img { width: 28px; height: 28px; border-radius: 8px; object-fit: cover; }
  .where-src { margin: 0; font-size: 12px; color: var(--dim); }
  .where-src a { color: inherit; }
  .t-body { padding-top: 48px; padding-bottom: 16px; }
  .t-main { max-width: 880px; display: flex; flex-direction: column; gap: 48px; }
  .t-main h2 { margin: 0 0 16px; font-size: 24px; line-height: 32px; font-weight: 600; }
  .more { margin: -12px 0 0; font-size: 14px; color: var(--dim); }
  .elsewhere { margin: 0; font-size: 14px; line-height: 24px; color: var(--dim); max-width: 720px; }
  .elsewhere a { color: var(--text-2); text-decoration: none; border-bottom: 1px solid var(--line-2); transition: color 300ms var(--ease), border-color 300ms var(--ease); }
  .elsewhere a:hover { color: var(--accent); border-color: var(--accent); }
  .more a { color: var(--muted); text-decoration: none; } .more a:hover { color: var(--text); }
  .syn { margin: 0; font-size: 16px; line-height: 26px; color: var(--text-2); max-width: 68ch; }
  .cast { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 24px 20px; }
  .cast a, .cast div { display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center; text-decoration: none; color: var(--text); }
  .cast a:hover .who > span { color: var(--accent); }
  .face { width: 104px; height: 104px; border-radius: 50%; position: relative; overflow: hidden; display: grid; place-items: center; background: linear-gradient(150deg, hsl(var(--h) 35% 30%), hsl(calc(var(--h) + 40) 30% 15%)); transition: transform .3s; }
  .cast a:hover .face { transform: scale(1.05); }
  .face b { font-size: 24px; font-weight: 600; color: hsl(var(--h) 40% 86%); }
  .face img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .who { display: flex; flex-direction: column; gap: 2px; font-weight: 500; font-size: 15px; line-height: 1.3; }
  .who small { font-size: 13px; color: var(--dim); font-weight: 400; }
  .seasons { list-style: none; margin: 0; padding: 0; border: 1px solid var(--line); border-radius: 16px; overflow: hidden; }
  .seasons li { display: flex; justify-content: space-between; gap: 16px; padding: 15px 20px; background: #12151D; border-top: 1px solid #1C202A; font-weight: 500; }
  .seasons li:first-child { border-top: 0; }
  .seasons small { font-size: 14px; color: var(--dim); font-weight: 400; }
  .seasons .soon span { color: var(--dim); }
  /* телефон: небольшой постер рядом с названием, всё остальное — во всю ширину */
  @media (max-width: 760px) {
    .hero-t .wrap { padding-top: 16px; padding-bottom: 32px; }
    .crumbs { margin-bottom: 16px; }
    .t-row { display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 16px 16px; align-items: start; }
    .t-info { display: contents; }
    .t-poster { grid-column: 1; grid-row: 1 / span 2; min-width: 0; width: 112px; border-radius: 12px; }
    .t-poster .ph { font-size: 14px; padding: 10px; }
    .t-info > :nth-child(1) { grid-column: 2; grid-row: 1; align-self: end; }
    .t-info > :nth-child(2) { grid-column: 2; grid-row: 2; align-self: start; }
    .t-info > :nth-child(n+3) { grid-column: 1 / -1; }
    h1 { font-size: 30px; line-height: 36px; }
    .t-orig { font-size: 14px; line-height: 20px; margin-top: 4px; }
    .facts p { font-size: 14px; line-height: 20px; }
    .facts p + p { font-size: 12px; line-height: 16px; }
    .clock { font-size: 16px; line-height: 24px; }
    .acts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .acts > :first-child { grid-column: 1 / -1; }
    .acts .btn { padding: 0 12px; height: 48px; }
    .t-body { padding-top: 32px; gap: 32px; }
    .t-main { gap: 32px; }
    .t-main h2 { font-size: 20px; line-height: 28px; margin-bottom: 12px; }
    .syn { font-size: 16px; }
    /* актёры — лентой */
    .cast { grid-auto-flow: column; grid-template-columns: none; grid-auto-columns: 96px; gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory;
      margin: 0 calc(-1 * var(--gut)); padding: 0 var(--gut) 4px; scrollbar-width: none; }
    .cast::-webkit-scrollbar { display: none; }
    .cast li { scroll-snap-align: start; }
    .face { width: 84px; height: 84px; }
    .face b { font-size: 20px; }
    .who { font-size: 13px; }
    .who small { font-size: 12px; }
    .seasons li { padding: 13px 16px; }
  }
</style>

<script>
  import { watchlist, toggleWatch } from '../lib/client.js';
  import { record } from '../lib/taste.js';
  const w = document.getElementById('watch')!;
  const id = w.dataset.id!;
  const paint = (on: boolean) => { w.setAttribute('aria-pressed', String(on)); w.querySelector('span')!.textContent = on ? 'В списке' : 'В мой список'; };
  paint(watchlist().includes(id));
  record(id, 'view'); // открытая страница — сигнал для подбора на главной
  w.addEventListener('click', () => { const on = toggleWatch(id); paint(on); if (on) record(id, 'watch'); });
  const t = document.getElementById('tonight')!;
  t.addEventListener('click', () => {
    try { localStorage.setItem('knv-today', JSON.stringify({ id, date: new Date().toDateString() })); } catch {}
    record(id, 'tonight'); // и «Смотрю сегодня», и «Смотреть в …» — выбор на вечер, сигнал для подбора
    if (t.tagName === 'BUTTON') t.textContent = 'Хорошего вечера!';
  });
</script>
