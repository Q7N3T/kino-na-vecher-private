---
import '../styles/global.css';
import { icon } from '../lib/icons.js';

interface Props { title?: string; description?: string; section?: string; image?: string; intro?: boolean }
const { title, description = 'Подберём фильм или сериал на сегодняшний вечер — по свободному времени и настроению.', section = '', image, intro = false } = Astro.props;
const INTRO_WORD = [...'Кино на вечер'];
const base = import.meta.env.BASE_URL;
const fullTitle = title ? `${title} — Кино на вечер` : 'Кино на вечер — что посмотреть сегодня';
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  ['', 'Главная'], ['filmy/', 'Фильмы'], ['serialy/', 'Сериалы'], ['podborki/', 'Подборки'], ['aktery/', 'Актёры'], ['izbrannoe/', 'Хочу посмотреть'],
];
const tabs = [
  ['', 'Главная', 'house'], ['filmy/', 'Фильмы', 'film'], ['serialy/', 'Сериалы', 'tv'], ['poisk/', 'Поиск', 'search'], ['izbrannoe/', 'Список', 'bookmark'],
];
const CONTACT = ''; // почта для сотрудничества, например "hello@example.ru"
---
<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<script is:inline define:vars={{ intro }}>
  document.documentElement.classList.add('js');
  // заставка — только на главной, один раз за визит и не тем, кто отключил анимацию в системе
  try {
    if (intro && !sessionStorage.getItem('knv-intro') && !matchMedia('(prefers-reduced-motion: reduce)').matches)
      document.documentElement.classList.add('intro-on');
  } catch {}
  // картинка не загрузилась через wsrv.nl — пробуем напрямую с TMDB, не вышло и так — остаётся заглушка
  window.knvImg = (i) => {
    const u = !i.dataset.f && new URL(i.src).searchParams.get('url');
    if (u) { i.dataset.f = 1; i.src = u; } else i.remove();
  };
</script>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{fullTitle}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta property="og:type" content="website">
<meta property="og:title" content={fullTitle}>
<meta property="og:description" content={description}>
{image && <meta property="og:image" content={image}>}
<meta name="theme-color" content="#131209">
<link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preconnect" href="https://wsrv.nl" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Unbounded:wght@700&display=swap" rel="stylesheet">
<slot name="head" />
</head>
<body data-base={base}>
<a class="skip" href="#main">К содержимому</a>
{intro && (
  <div class="intro" id="intro" aria-hidden="true">
    <div class="intro-bar is-up"></div>
    <div class="intro-bar is-down"></div>
    <div class="intro-beam"></div>
    <div class="intro-c">
      <i class="intro-dot"></i>
      <span class="intro-w">{INTRO_WORD.map((ch, i) => <span style={`--i:${i}`}>{ch === ' ' ? '\u00a0' : ch}</span>)}</span>
    </div>
    <div class="intro-grain"></div>
    <script is:inline>
      (() => {
        const html = document.documentElement, el = document.getElementById('intro');
        if (!html.classList.contains('intro-on')) { el.remove(); return; }
        // как начало сеанса: точка разгорается, проявляется название, проходит луч, кадр раскрывается
        let done = false;
        const finish = () => { if (done) return; done = true; html.classList.remove('intro-on', 'intro-open'); el.remove(); try { sessionStorage.setItem('knv-intro', '1'); } catch {} };
        const open = () => { if (done || html.classList.contains('intro-open')) return; html.classList.add('intro-open'); setTimeout(finish, 750); };
        // отсчёт — с первого кадра: пока грузятся шрифты, страница ещё не нарисована
        requestAnimationFrame(() => setTimeout(open, 1500));
        // любое действие пропускает заставку
        ['pointerdown', 'keydown', 'wheel', 'touchstart'].forEach((t) => addEventListener(t, open, { once: true, passive: true }));
        addEventListener('pageshow', (e) => { if (e.persisted) finish(); });
      })();
    </script>
  </div>
)}
<header class="top">
  <div class="bar">
    <a class="logo" href={base}><i aria-hidden="true"></i>Кино на вечер</a>
    <nav class="nav" aria-label="Разделы">
      {nav.map(([href, label]) => <a href={base + href} aria-current={section === href ? 'page' : undefined}>{label}</a>)}
    </nav>
    <form class="search" action={`${base}poisk/`} method="get" role="search">
      <Fragment set:html={icon('search', 18)} />
      <label class="sr" for="q-top">Поиск</label>
      <input id="q-top" name="q" type="search" placeholder="Фильм, сериал, актёр" autocomplete="off">
    </form>
    <a class="top-search" href={`${base}poisk/`} aria-label="Поиск" set:html={icon('search', 22)}></a>
  </div>
</header>
<main id="main">
  <slot />
</main>
<footer class="foot">
  <div class="wrap">
    <div class="foot-main">
      <a class="logo" href={base}><i aria-hidden="true"></i>Кино на вечер</a>
      <p>Информация о фильмах и сериалах предоставлена <a href="https://www.imdb.com" rel="noopener">IMDb</a> и используется с их разрешения.<br><span lang="en">Information courtesy of IMDb (<a href="https://www.imdb.com" rel="noopener">https://www.imdb.com</a>). Used with permission.</span></p>
      <p>Где посмотреть — <a href="https://www.justwatch.com" rel="noopener">JustWatch</a>. Постеры, описания и фото — <a href="https://www.themoviedb.org" rel="noopener">TMDB</a>. <span lang="en">This product uses the TMDB API but is not endorsed or certified by TMDB.</span></p>
    </div>
    <nav class="foot-links" aria-label="Ссылки">
      <a href={`${base}filmy/`}>Фильмы</a>
      <a href={`${base}o-proekte/`}>О проекте</a>
      <a href={`${base}serialy/`}>Сериалы</a>
      {CONTACT ? <a href={`mailto:${CONTACT}`}>Сотрудничество: {CONTACT}</a> : <span style="color: var(--dim)">Сотрудничество: скоро</span>}
      <a href={`${base}podborki/`}>Подборки</a>
      <a href={`${base}aktery/`}>Актёры</a>
      <a href={`${base}konfidencialnost/`}>Конфиденциальность</a>
    </nav>
  </div>
</footer>
<!-- на телефоне разделы — в нижней панели, как в приложениях -->
<nav class="tabbar" aria-label="Разделы">
  {tabs.map(([href, label, ic]) => (
    <a href={base + href} aria-current={section === href ? 'page' : undefined}>
      <Fragment set:html={icon(ic, 24)} />
      <span>{label}</span>
    </a>
  ))}
</nav>
<script>
  // время окончания считается в браузере зрителя: «финал в 22:44, если начать сейчас»
  import { pad } from '../lib/format.js';
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fill = () => {
    const now = Date.now();
    document.querySelectorAll<HTMLElement>('[data-end]').forEach((el) => {
      const d = new Date(now + Number(el.dataset.end) * 60000);
      const v = pad(d.getHours()) + ':' + pad(d.getMinutes());
      const old = el.textContent || '';
      if (old === v) return; // иначе MutationObserver ниже зациклится
      // время сменилось — изменившиеся цифры перещёлкиваются, как на табло
      el.innerHTML = old.length === v.length && !reduce
        ? [...v].map((c, i) => (c === old[i] ? c : `<span class="tick" style="--i:${i}">${c}</span>`)).join('')
        : v;
    });
    document.querySelectorAll<HTMLElement>('[data-now]').forEach((el) => {
      const d = new Date(now);
      const v = pad(d.getHours()) + ':' + pad(d.getMinutes());
      if (el.textContent !== v) el.textContent = v;
    });
  };
  fill();
  setInterval(fill, 30000);

  // переход к фильму: постер нажатой карточки получает то же имя, что постер на странице фильма
  const named = () => document.querySelectorAll<HTMLElement>('[data-vt]').forEach((p) => { p.style.viewTransitionName = ''; delete p.dataset.vt; });
  document.addEventListener('click', (e) => {
    if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    const a = (e.target as HTMLElement).closest('a[href]');
    const p = a?.querySelector<HTMLElement>('.poster');
    if (!p || p.classList.contains('t-poster')) return;
    named();
    // на странице фильма имя уже занято его постером: одно имя — один элемент, иначе браузер отменит переход
    document.querySelectorAll<HTMLElement>('.t-poster').forEach((t) => { t.style.viewTransitionName = 'none'; t.dataset.vt = '1'; });
    p.style.viewTransitionName = 'poster';
    p.dataset.vt = '1';
  });
  addEventListener('pageshow', named); // вернулись назад — имя больше не нужно
  // карточки, которые дорисовывает браузер, тоже получают время
  // и те, у которых сменилась длительность (карточка «Выбор на сегодня» после кубика)
  new MutationObserver(fill).observe(document.querySelector('main')!, { childList: true, subtree: true, attributes: true, attributeFilter: ['data-end'] });
</script>
</body>
</html>
