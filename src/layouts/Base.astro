---
import '../styles/global.css';

interface Props { title?: string; description?: string; section?: string; image?: string }
const { title, description = 'Подберём фильм или сериал на сегодняшний вечер — по свободному времени и настроению.', section = '', image } = Astro.props;
const base = import.meta.env.BASE_URL;
const fullTitle = title ? `${title} — Кино на вечер` : 'Кино на вечер — что посмотреть сегодня';
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  ['', 'Главная'], ['filmy/', 'Фильмы'], ['serialy/', 'Сериалы'], ['podborki/', 'Подборки'], ['aktery/', 'Актёры'], ['izbrannoe/', 'Хочу посмотреть'],
];
const CONTACT = ''; // почта для сотрудничества, например "hello@example.ru"
---
<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{fullTitle}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta property="og:type" content="website">
<meta property="og:title" content={fullTitle}>
<meta property="og:description" content={description}>
{image && <meta property="og:image" content={image}>}
<meta name="theme-color" content="#0D0F14">
<link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preconnect" href="https://wsrv.nl" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700&family=Unbounded:wght@700&display=swap" rel="stylesheet">
<slot name="head" />
</head>
<body data-base={base}>
<header class="top">
  <div class="wrap">
    <a class="logo" href={base}><i aria-hidden="true"></i>Кино на вечер</a>
    <nav class="nav" aria-label="Разделы">
      {nav.map(([href, label]) => <a href={base + href} aria-current={section === href ? 'page' : undefined}>{label}</a>)}
    </nav>
    <form class="search" action={`${base}poisk/`} method="get" role="search">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#9AA0AC" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      <label class="sr" for="q-top">Поиск</label>
      <input id="q-top" name="q" type="search" placeholder="Фильм, сериал или актёр" autocomplete="off">
    </form>
  </div>
</header>
<main>
  <slot />
</main>
<footer class="foot">
  <div class="wrap">
    <div class="foot-main">
      <a class="logo" href={base}><i aria-hidden="true"></i>Кино на вечер</a>
      <p>Информация о фильмах и сериалах предоставлена <a href="https://www.imdb.com" rel="noopener">IMDb</a> и используется с их разрешения.<br><span lang="en">Information courtesy of IMDb (<a href="https://www.imdb.com" rel="noopener">https://www.imdb.com</a>). Used with permission.</span></p>
      <p>Постеры, описания и фото — <a href="https://www.themoviedb.org" rel="noopener">TMDB</a>. <span lang="en">This product uses the TMDB API but is not endorsed or certified by TMDB.</span></p>
    </div>
    <nav class="foot-links" aria-label="Ссылки">
      <a href={`${base}filmy/`}>Фильмы</a>
      <a href={`${base}o-proekte/`}>О проекте</a>
      <a href={`${base}serialy/`}>Сериалы</a>
      {CONTACT ? <a href={`mailto:${CONTACT}`}>Сотрудничество: {CONTACT}</a> : <span style="color: var(--dim)">Сотрудничество: скоро</span>}
      <a href={`${base}podborki/`}>Подборки</a>
      <a href={`${base}aktery/`}>Актёры</a>
    </nav>
  </div>
</footer>
<script>
  // время окончания считается в браузере зрителя: «финал в 22:44, если начать сейчас»
  import { pad } from '../lib/format.js';
  const fill = () => {
    const now = Date.now();
    document.querySelectorAll<HTMLElement>('[data-end]').forEach((el) => {
      const d = new Date(now + Number(el.dataset.end) * 60000);
      const v = pad(d.getHours()) + ':' + pad(d.getMinutes());
      if (el.textContent !== v) el.textContent = v; // иначе MutationObserver ниже зациклится
    });
    document.querySelectorAll<HTMLElement>('[data-now]').forEach((el) => {
      const d = new Date(now);
      const v = pad(d.getHours()) + ':' + pad(d.getMinutes());
      if (el.textContent !== v) el.textContent = v;
    });
  };
  fill();
  setInterval(fill, 30000);
  // карточки, которые дорисовывает браузер, тоже получают время
  new MutationObserver(fill).observe(document.querySelector('main')!, { childList: true, subtree: true });
</script>
</body>
</html>
