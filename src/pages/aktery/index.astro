---
import Base from '../../layouts/Base.astro';
import { load } from '../../lib/data.js';
import { tmdbImg, hue, initials, plural, num } from '../../lib/format.js';
const base = import.meta.env.BASE_URL;
const { actors } = load();
const top = actors.slice(0, 120);
---
<Base title="Актёры" section="aktery/" description="Популярные актёры и актрисы: фото и фильмография с рейтингами IMDb.">
  <div class="wrap">
    <header class="page-h"><h1>Актёры</h1><p>{num(actors.length)} актёров и актрис, которые снимались хотя бы в трёх фильмах или сериалах из базы. Найти любого можно через поиск.</p></header>
    <ul class="people">
      {top.map((a, i) => (
        <li style={`--i:${Math.min(i, 12)}`}><a href={`${base}akter/${a.slug}/`}>
          <span class="face" style={`--h:${hue(a.n)}`}>{a.p && <img src={tmdbImg(a.p, 200, 'w185')} alt="" loading="lazy" onerror="knvImg(this)" />}<b aria-hidden="true">{initials(a.n)}</b></span>
          <span class="nm">{a.n}</span><small>{a.roles.length} {plural(a.roles.length, 'роль', 'роли', 'ролей')}</small>
        </a></li>
      ))}
    </ul>
  </div>
</Base>
<style>
  .people { list-style: none; margin: 0; padding: 32px 0 24px; display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 28px 20px; }
  .people li { animation: rise .5s cubic-bezier(.2, .8, .2, 1) both; animation-delay: calc(var(--i) * 40ms); }
  .people a { display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center; text-decoration: none; color: var(--text); }
  .people a:hover .nm { color: var(--accent); }
  .face { width: 128px; height: 128px; border-radius: 50%; position: relative; overflow: hidden; display: grid; place-items: center; background: linear-gradient(150deg, hsl(var(--h) 35% 30%), hsl(calc(var(--h) + 40) 30% 15%)); transition: transform .3s; }
  .people a:hover .face { transform: scale(1.05); }
  .face b { font-size: 28px; font-weight: 600; color: hsl(var(--h) 40% 86%); }
  .face img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .nm { font-weight: 500; line-height: 1.3; transition: color .2s; }
  small { color: var(--dim); font-size: 13px; }
</style>
