---
import Base from '../../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---
<Base title="Мой список" section="izbrannoe/" description="Ваш список фильмов и сериалов на потом.">
  <div class="wrap">
    <header class="page-h"><h1>Мой список</h1><p>Фильмы и сериалы на потом. Список хранится только в этом браузере.</p></header>
    <div class="grid" id="grid" style="padding-top: 32px"></div>
    <div class="empty" id="empty" hidden><h2>Пока пусто</h2><p>Нажмите «В мой список» на странице фильма или сериала — он появится здесь.</p><a class="btn" href={base}>Подобрать на вечер</a></div>
    <section class="taste">
      <h2>Ваши вкусы</h2>
      <p>Подбор на главной учитывает, что вы открывали, добавляли сюда и выбирали «Смотрю сегодня». Всё это хранится только в этом браузере.</p>
      <button class="btn ghost" id="forget">Забыть мои вкусы</button>
    </section>
  </div>
</Base>
<style>
  .taste { margin: 48px 0 24px; padding-top: 32px; border-top: 1px solid var(--line); max-width: 60ch; }
  .taste h2 { margin: 0 0 8px; font-size: 20px; }
  .taste p { margin: 0 0 16px; color: var(--muted); }
</style>
<script>
  import { forget } from '../../lib/taste.js';
  const fb = document.getElementById('forget')!;
  fb.addEventListener('click', () => { forget(); fb.textContent = 'Готово, подбор начнётся с чистого листа'; fb.setAttribute('disabled', ''); });
</script>
<script>
  import { loadIndex, watchlist, base } from '../../lib/client.js';
  import { cardHTML } from '../../lib/format.js';
  const ids = watchlist();
  if (!ids.length) document.getElementById('empty')!.hidden = false;
  else loadIndex().then((all) => {
    const by = new Map(all.map((f: any) => [f.id, f]));
    document.getElementById('grid')!.innerHTML = ids.map((id) => by.get(id)).filter(Boolean).map((f, i) => cardHTML(f, base, { i })).join('');
  });
</script>
