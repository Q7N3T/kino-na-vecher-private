---
import Base from '../../layouts/Base.astro';
import { load } from '../../lib/data.js';
import { num, plural } from '../../lib/format.js';
import { icon } from '../../lib/icons.js';
const { films, actors } = load();
const s = films.filter((f) => f.k).length;
const TAGLINE = ['Не листайте каталог весь вечер.', 'Скажите, сколько есть времени, и через минуту начинайте смотреть.'];
const STEPS = [
  ['Сколько есть времени', 'Полтора часа, два или весь вечер. Фильмы длиннее не попадут в подборку, а у сериала считается одна серия.'],
  ['Какое настроение', 'Посмеяться, понервничать, погрустить, подумать или вдохновиться. Жанры уже разобраны по настроению.'],
  ['Во сколько закончите', 'У фильма на карточке видно время финала, у сериала — сколько серий успеете и когда закончите, если начать прямо сейчас.'],
];
const BENEFITS = [
  ['Находки, а не только хиты', 'в подборке рядом с известным есть фильмы с высоким рейтингом, о которых говорят реже.'],
  ['Честные сезоны', 'считаем только вышедшие серии, а у сериала видно, продолжается он или завершён.'],
  ['Без регистрации', 'подбор учится на том, что вы открываете, и хранит это только в вашем браузере.'],
  ['Где посмотреть', 'на странице фильма собраны легальные онлайн кинотеатры в России.'],
];
const FAQ = [
  ['Как работает подбор?', 'Вы выбираете, сколько есть времени, какое настроение и что смотреть: фильм или сериал. Подборка из двенадцати карточек — золотая середина: больше всего хорошего кино, о котором многие слышали, но не все видели, а ещё находки с высоким рейтингом, свежее последних пяти лет, один громкий хит, классика и, если есть история, то, что похоже на ваш вкус.'],
  ['Почему «Выбор на сегодня» каждый день новый?', 'Это один фильм или сериал на весь день — находка или хорошее кино, которое вы могли пропустить. Он меняется в полночь, а при тех же фильтрах весь день остаётся одним и тем же. Кнопка с кубиком предложит случайный вариант, а «Выбор дня» вернёт его обратно.'],
  ['Что значит метка «Находка»?', 'Фильм с высоким рейтингом IMDb и не меньше чем 20 тысячами оценок, который при этом мало кто смотрел. Такие подборки меняются каждый день.'],
  ['Можно посмотреть фильм прямо на сайте?', 'Нет. Мы помогаем выбрать, а на странице фильма показываем, в каких легальных онлайн кинотеатрах он есть: по подписке, бесплатно, в аренду или на покупку.'],
  ['Откуда рейтинги и описания?', 'Названия, годы, длительность, жанры, рейтинги, сезоны и серии взяты из открытых данных IMDb. Постеры, описания и фото актёров взяты из TMDB, а данные о кинотеатрах из JustWatch.'],
  ['Как часто обновляется база?', 'Каждую неделю, в ночь на понедельник. В базе фильмы и сериалы, у которых на IMDb не меньше 10 тысяч оценок.'],
  ['Нужна ли регистрация?', 'Нет. «Мой список» и история для подбора хранятся только в вашем браузере. Стереть историю можно на странице «Мой список».'],
  ['Сколько это стоит?', 'Ничего. Сайт бесплатный и без рекламы.'],
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: FAQ.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
---
<Base title="О проекте" description="Как устроен сервис «Кино на вечер» и откуда данные.">
  <div class="wrap prose">
    <header class="page-h"><h1>О проекте</h1></header>
    <p>«Кино на вечер» помогает выбрать, что посмотреть сегодня. Вечером обычно известны две вещи: сколько есть времени и какое настроение. С них и начинается подбор, а на каждой карточке видно, во сколько закончится фильм или серия, если начать прямо сейчас.</p>
    <section aria-labelledby="h-how">
      <h2 id="h-how">Как это работает</h2>
      <ol class="steps">
        {STEPS.map(([t, d], i) => <li class="step"><span class="step-n">{String(i + 1).padStart(2, '0')}</span><h3>{t}</h3><p>{d}</p></li>)}
      </ol>
      <ul class="benefits">
        {BENEFITS.map(([t, d]) => <li><b>{t}</b> — {d}</li>)}
      </ul>
    </section>
    <h2>Что в базе</h2>
    <p>{num(films.length - s)} {plural(films.length - s, 'фильм', 'фильма', 'фильмов')} и {num(s)} {plural(s, 'сериал', 'сериала', 'сериалов')}, у которых на IMDb больше 10 тысяч оценок, и {num(actors.length)} {plural(actors.length, 'актёр', 'актёра', 'актёров')}. База обновляется каждую неделю.</p>
    <h2>Откуда данные</h2>
    <p>Названия, годы, длительность, жанры, рейтинги, сезоны и серии — из открытых датасетов IMDb. Information courtesy of IMDb (<a href="https://www.imdb.com">https://www.imdb.com</a>). Used with permission.</p>
    <p>Постеры, описания, фото актёров, популярность и статусы сериалов — из <a href="https://www.themoviedb.org">TMDB</a>. This product uses the TMDB API but is not endorsed or certified by TMDB.</p>
    <p>Настроения («посмеяться», «понервничать», «погрустить», «подумать», «вдохновиться») выводятся из жанров автоматически.</p>
    <h2>Подбор под вас</h2>
    <p>Чем больше вы открываете фильмы, добавляете их в «Мой список» и отмечаете «Смотрю сегодня», тем точнее подборка на главной: выше поднимается похожее по жанрам, настроению, десятилетию и режиссёрам, но не обязательно то же самое. «Выбор на сегодня» меняется каждый день в полночь. История хранится только в вашем браузере, сбросить её можно на странице «Мой список».</p>
    <section class="faq" aria-labelledby="h-faq">
      <h2 id="h-faq">Вопросы и ответы</h2>
      <div class="faq-l">
        {FAQ.map(([q, a]) => <details><summary><span>{q}</span><Fragment set:html={icon('caret', 20)} /></summary><p>{a}</p></details>)}
      </div>
      <script type="application/ld+json" set:html={JSON.stringify(faqLd)}></script>
    </section>
  </div>
</Base>
<style>
  .prose { max-width: 760px; padding-bottom: 40px; }
  .prose p { font-size: 17px; line-height: 1.65; color: var(--text-2); }
  .prose h2 { font-size: 22px; margin: 36px 0 10px; }
  .prose :is(.steps, .benefits, .faq) p { font-size: 16px; line-height: 24px; color: var(--muted); }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .step { padding: 24px; border-radius: 16px; background: var(--surface); border: 1px solid var(--line); }
  .step-n { font-size: 14px; line-height: 20px; font-weight: 600; color: var(--accent); }
  .step h3 { margin: 12px 0 8px; font-size: 20px; line-height: 28px; font-weight: 600; }
  .step p { margin: 0; font-size: 16px; line-height: 24px; color: var(--muted); }
  .benefits { list-style: none; margin: 32px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 48px; }
  .benefits li { font-size: 16px; line-height: 24px; color: var(--muted); }
  .benefits b { color: var(--text); font-weight: 600; }

  .faq-l { max-width: 880px; border-radius: 16px; border: 1px solid var(--line); background: var(--surface); overflow: hidden; }
  .faq details + details { border-top: 1px solid var(--line); }
  .faq summary { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 24px; cursor: pointer; list-style: none; font-size: 18px; line-height: 28px; font-weight: 600; transition: color 300ms var(--ease), background 300ms var(--ease); }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary > span { transition: transform 500ms var(--ease); }
  .faq summary:hover { background: var(--surface-2); }
  .faq summary:hover > span { transform: translateX(4px); }
  .faq summary:active > span { transform: translateX(4px) translateY(1px); }
  .faq details[open] summary { color: var(--accent); }
  .faq summary:focus-visible { outline-offset: -2px; border-radius: 16px; }
  .faq summary :global(svg) { flex-shrink: 0; color: var(--dim); transition: transform 500ms var(--ease), color 300ms var(--ease); }
  .faq summary:hover :global(svg) { color: var(--text); }
  .faq details[open] summary :global(svg) { transform: rotate(180deg); color: var(--accent); }
  .faq details p { margin: 0; padding: 0 24px 24px; max-width: 720px; font-size: 16px; line-height: 24px; color: var(--muted); }
  /* ответ выезжает и проявляется; при закрытии — уходит обратно, потом details закрывается */
  .faq details[open] p { animation: faq-in 500ms var(--ease) both; }
  .faq details.closing p { animation: faq-out 300ms var(--ease) both; }
  @keyframes faq-in { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: none; } }
  @keyframes faq-out { from { opacity: 1; transform: none; } to { opacity: 0; transform: translateY(-8px); } }
  @media (max-width: 760px) {
    .steps { grid-template-columns: minmax(0, 1fr); }
    .benefits { grid-template-columns: minmax(0, 1fr); margin-top: 24px; }
    .faq summary { padding: 16px; font-size: 16px; line-height: 24px; }
    .faq details p { padding: 0 16px 16px; }
  }
</style>
<script>
  // закрытие вопроса: сначала ответ уходит, потом details закрывается
  document.querySelectorAll<HTMLDetailsElement>('.faq details').forEach((d) => {
    d.querySelector('summary')!.addEventListener('click', (e) => {
      if (!d.open || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      e.preventDefault();
      d.classList.add('closing');
      setTimeout(() => { d.open = false; d.classList.remove('closing'); }, 300);
    });
  });
</script>
