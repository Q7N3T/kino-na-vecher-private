---
import Base from '../layouts/Base.astro';
import { load, COLLECTIONS } from '../lib/data.js';
import { curate, popularNow } from '../lib/curate.js';
import { cardHTML, MOODS, TIMES, KINDS, cap, hue, tmdbImg, kindName, seasons, dur, num, finish, plural } from '../lib/format.js';
import { icon } from '../lib/icons.js';
import CollTile from '../components/CollTile.astro';

const base = import.meta.env.BASE_URL;
const { films } = load();
const DEF = { time: 105, mood: 'laugh', kind: 'any' };
// та же подборка, что соберёт браузер, — чтобы при загрузке ничего не мелькало
const curated = curate(films.filter((f) => f.min <= DEF.time && f.m.includes(DEF.mood)), { time: DEF.time, mood: DEF.mood, day: new Date().toDateString() }).items;
const tonight = curated.map((x) => x.f);
const WHY = { gem: 'Находка', classic: 'Классика', taste: 'По вашему вкусу' };
// в собранной странице — только вкладка «Всё»; «Фильмы» и «Сериалы» браузер рисует по клику
const popular = popularNow(films, { exclude: new Set(tonight.map((f) => f.id)) });
const colls = COLLECTIONS.slice(0, 4);
const nSeries = films.filter((f) => f.k).length;
// слоган: каждое слово отдельно, чтобы при прокрутке они проявлялись по одному
---
<Base section="" intro>
  <section class="wrap hero">
    <div class="hero-main">
      <p class="eyebrow enter" style="--d:0">Сейчас <span data-now></span> · подберём под ваш вечер</p>
      <h1 class="sentence enter" style="--d:1">Сегодня у меня <span class="nw"><button class="slot" id="s-time" data-menu="m-time" aria-haspopup="listbox" aria-expanded="false" aria-controls="m-time"><span class="slot-w">{TIMES[0].word}</span><Fragment set:html={icon('caret', 20)} /></button>,</span> хочется <span class="nw"><button class="slot" id="s-mood" data-menu="m-mood" aria-haspopup="listbox" aria-expanded="false" aria-controls="m-mood"><span class="slot-w">{MOODS[0].word}</span><Fragment set:html={icon('caret', 20)} /></button>.</span> Смотрим <button class="slot" id="s-kind" data-menu="m-kind" aria-haspopup="listbox" aria-expanded="false" aria-controls="m-kind"><span class="slot-w">{KINDS[0].word}</span><Fragment set:html={icon('caret', 20)} /></button></h1>
      <p class="lead enter" style="--d:2">Нажмите на выделенные слова: подберём фильм или сериал под ваш вечер и покажем, во сколько закончите.</p>
      <!-- меню выделенных слов: одно открыто за раз, под словом -->
      <div class="menu" id="m-time" role="listbox" aria-label="Сколько есть времени" hidden>{TIMES.map((t) => <button class="opt" role="option" data-time={t.v} aria-selected={String(t.v === DEF.time)}>{t.chip}</button>)}</div>
      <div class="menu" id="m-mood" role="listbox" aria-label="Какое настроение" hidden>{[...MOODS, { v: 'any', word: 'неважно' }].map((m) => <button class="opt" role="option" data-mood={m.v} aria-selected={String(m.v === DEF.mood)}>{cap(m.word)}</button>)}</div>
      <div class="menu" id="m-kind" role="listbox" aria-label="Что смотрим" hidden>{KINDS.map((k) => <button class="opt" role="option" data-kind={k.v} aria-selected={String(k.v === DEF.kind)}>{cap(k.forms[0])}</button>)}</div>
      <p class="proof enter" style="--d:3"><b>{num(films.length - nSeries)}</b> {plural(films.length - nSeries, 'фильм', 'фильма', 'фильмов')} и <b>{num(nSeries)}</b> {plural(nSeries, 'сериал', 'сериала', 'сериалов')} с рейтингом IMDb · база обновляется каждую неделю</p>
    </div>
    <div class="pick enter" id="pick-card" style="--d:3">
      <a class="pick-a" id="pick-a" data-umami-event="Выбор на сегодня" href={`${base}${tonight[0].k ? 'serial' : 'film'}/${tonight[0].slug}/`}>
        <span class="pick-p poster" style={`--h:${hue(tonight[0].id)}`} id="pick-poster" set:html={tonight[0].p ? `<img src="${tmdbImg(tonight[0].p, 200)}" alt="" onerror="knvImg(this)">` : ''}></span>
        <span class="pick-b">
          <small id="pick-l">Выбор на сегодня</small>
          <b id="pick-t">{tonight[0].t}</b>
          <span id="pick-m">{tonight[0].k ? `${kindName(tonight[0])} · ${seasons(tonight[0])} · серия ${dur(tonight[0].min)}` : `${tonight[0].y} · ${dur(tonight[0].min)} · IMDb ${tonight[0].imdb.toFixed(1)}`}</span>
          <span class="pick-e" id="pick-e"><span id="pick-pre">{cap(finish(tonight[0], DEF.time).text)}</span> <span data-end={finish(tonight[0], DEF.time).min}></span></span>
        </span>
      </a>
      <div class="pick-f">
        <span class="pick-n" id="pick-n">Новый выбор — в полночь</span>
        <button class="back" id="pick-back" type="button" hidden><Fragment set:html={icon('undo', 16)} /><span>Выбор дня</span></button>
        <button class="dice" id="dice" type="button" aria-label="Случайный выбор под ваш вечер" data-umami-event="Кубик"><Fragment set:html={icon('dice', 18)} /><span id="dice-t">Не то? Случайный</span></button>
      </div>
    </div>
  </section>

  <section class="sec wrap" aria-labelledby="h-tonight">
    <div class="sec-h">
      <h2 id="h-tonight">Подходит на сегодня <small id="tonight-n"></small></h2>
      <div style="display:flex;gap:16px;align-items:center;flex-wrap:wrap">
        <a class="more-link" id="tonight-all" href={`${base}filmy/`}>Все →</a>
      </div>
    </div>
    <div class="grid row" id="tonight" set:html={curated.map((x, i) => cardHTML(x.f, base, { i, why: WHY[x.why], time: DEF.time })).join('')}></div>
  </section>

  <section class="sec band reveal" aria-labelledby="h-colls">
    <div class="wrap">
      <div class="sec-h"><h2 id="h-colls">Подборки</h2><a class="more-link" href={`${base}podborki/`}>Все подборки →</a></div>
      <div class="colls">
        {colls.map((c) => (
          <CollTile c={c} />
        ))}
      </div>
    </div>
  </section>

  <section class="sec wrap" aria-labelledby="h-pop">
    <div class="sec-h">
      <h2 id="h-pop">Популярное сейчас</h2>
      <div class="chips" role="group" aria-label="Тип" id="pop-tabs">
        <button class="chip" data-tab="all" aria-pressed="true">Всё</button>
        <button class="chip" data-tab="movie" aria-pressed="false">Фильмы</button>
        <button class="chip" data-tab="series" aria-pressed="false">Сериалы</button>
      </div>
    </div>
    <div class="grid row" id="pop" set:html={popular.map((f, i) => cardHTML(f, base, { i })).join('')}></div>
  </section>


</Base>

<style>
  .hero { display: flex; flex-wrap: wrap; gap: 40px 48px; align-items: flex-end; padding-top: 64px; padding-bottom: 24px; }
  .hero-main { flex: 999 1 640px; min-width: 0; }
  .sentence { margin: 0; font-weight: 600; font-size: 60px; line-height: 1; letter-spacing: -.02em; max-width: 680px;
    background: linear-gradient(90deg, #FFFFFF, #9B9B9B); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .nw { white-space: nowrap; }
  .lead { margin: 24px 0 0; max-width: 680px; font-size: 18px; line-height: 28px; color: var(--muted); }
  .proof { margin: 24px 0 0; font-size: 14px; line-height: 20px; color: var(--dim); }
  .proof b { color: var(--text-2); font-weight: 600; }
  .slot { font: inherit; color: var(--accent); -webkit-text-fill-color: var(--accent); background: none; border: 0; padding: 0; border-bottom: 3px solid var(--accent); cursor: pointer; line-height: 1.05; display: inline-block; transition: color 300ms var(--ease); }
  .slot:hover { color: var(--accent-hi); }
  /* перелистывание: новое слово выезжает снизу, лишнее обрезано по краю строки, подчёркивание видно */
  .slot { clip-path: inset(-.15em -.3em 0 -.3em); }
  .slot :global(.sv) { display: inline-block; animation: flip-in 500ms var(--ease) both; }
  @keyframes flip-in { from { opacity: 0; transform: translateY(70%); } to { opacity: 1; transform: none; } }
  .hero-main { position: relative; }
  .slot :global(svg) { width: .4em; height: .4em; margin-left: .08em; vertical-align: .12em; transition: transform 500ms var(--ease); }
  .slot[aria-expanded="true"] :global(svg) { transform: rotate(180deg); }
  .menu { position: absolute; z-index: 30; min-width: 224px; display: flex; flex-direction: column; gap: 4px; padding: 8px; border-radius: 16px;
    background: var(--surface-2); border: 1px solid var(--line-2); box-shadow: 0 24px 48px -16px rgba(0, 0, 0, .8); animation: menu-in 300ms var(--ease) both; }
  .opt { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 8px 12px; border-radius: 8px; border: 0; background: transparent;
    font-size: 16px; line-height: 24px; font-weight: 500; text-align: left; cursor: pointer; transition: background 300ms var(--ease), color 300ms var(--ease); }
  .opt:hover, .opt:focus-visible { background: var(--surface); outline: none; }
  .opt[aria-selected="true"] { color: var(--accent); font-weight: 600; }
  .opt[aria-selected="true"]::after { content: '✓'; }
  @keyframes menu-in { from { opacity: 0; transform: translateY(-8px) scale(.98); } to { opacity: 1; transform: none; } }
  .pick { flex: 1 1 320px; background: var(--surface); border: 1px solid var(--line); border-radius: 24px; padding: 24px; display: flex; flex-direction: column; gap: 16px; transition: border-color 300ms var(--ease), transform 500ms var(--ease); }
  .pick:hover { border-color: var(--line-2); transform: translateY(-3px); }
  .pick-a { display: flex; gap: 16px; align-items: center; text-decoration: none; color: var(--text); }
  .pick-a:hover { color: var(--text); }
  .pick-p { width: 96px; flex-shrink: 0; margin: 0; }
  .pick-b { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .pick-b small { font-size: 12px; color: var(--dim); }
  .pick-b b { font-size: 20px; font-weight: 600; line-height: 1.25; }
  .pick-b > span { font-size: 14px; color: var(--muted); }
  .pick-b .pick-e { color: var(--accent); }
  .pick-b .pick-e:has([data-end]:empty) { visibility: hidden; } /* время ещё не посчитано */
  .pick-f { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-top: 12px; border-top: 1px solid var(--line); }
  .pick-n { font-size: 12px; color: var(--dim); min-width: 0; }
  .back { display: inline-flex; align-items: center; gap: 8px; height: 38px; padding: 0 16px 0 12px; border-radius: 9999px; border: 1px solid var(--line); background: var(--surface-2); color: var(--muted); font: inherit; font-size: 14px; font-weight: 500; cursor: pointer; white-space: nowrap; transition: border-color 300ms var(--ease), color 300ms var(--ease); }
  .back:hover { border-color: var(--line-2); color: var(--text); }
  .back:hover :global(svg) { transform: rotate(-90deg); }
  .back :global(svg) { transition: transform 500ms var(--ease); }
  .back:active { transform: scale(.97); }
  .dice { display: inline-flex; align-items: center; gap: 8px; height: 38px; padding: 0 16px; border-radius: 9999px; border: 1px solid var(--line-2); background: transparent; color: var(--text); font: inherit; font-size: 14px; font-weight: 500; cursor: pointer; white-space: nowrap; transition: border-color 300ms var(--ease), color 300ms var(--ease); }
  .dice:hover { border-color: var(--accent); color: var(--accent); }
  .dice:active { transform: scale(.97); }
  .dice.roll :global(svg) { animation: tumble .6s var(--ease); }
  @keyframes tumble { 0% { transform: rotate(0) } 100% { transform: rotate(540deg) } }
  .pick.spin #pick-t { color: var(--dim); }
  .pick.spin #pick-m, .pick.spin #pick-e { visibility: hidden; }
  .pick-p :global(.reel) { position: absolute; inset: 0; display: flex; flex-direction: column; height: calc(var(--n) * 100%); animation: reel var(--t) var(--ease) both; }
  .pick-p :global(.reel-i) { position: relative; flex: 1 1 0; overflow: hidden; background: hsl(var(--h) 26% 20%); }
  .pick-p :global(.reel-i img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1; }
  .pick-p :global(.reel-i .ph) { font-size: 12px; padding: 8px; }
  @keyframes reel { from { transform: translateY(0); } to { transform: translateY(calc(-100% + 100% / var(--n))); } }
  .pick.done .pick-a { animation: pop .45s var(--ease); }
  @keyframes pop { 0% { transform: scale(.92); opacity: .3; } 100% { transform: none; opacity: 1; } }



  @media (max-width: 760px) {
    .sentence { font-size: 36px; line-height: 40px; }
    .lead { margin-top: 16px; font-size: 16px; line-height: 24px; }
    .proof { margin-top: 16px; font-size: 12px; line-height: 16px; }
    .hero { padding-top: 24px; gap: 24px; }
    .eyebrow { margin-bottom: 12px; }
    .pick { padding: 16px; gap: 12px; border-radius: 16px; }
    .pick-a { gap: 16px; }
    .pick-f { padding-top: 12px; }
    .pick-p { width: 64px; }
    .pick-b b { font-size: 16px; }
  }
</style>

<script>
  import { loadIndex, matches, base, watchlist } from '../lib/client.js';
  import { profile } from '../lib/taste.js';
  import { curate, dailyPick, popularNow } from '../lib/curate.js';
  import { cardHTML, MOODS, TIMES, KINDS, plural, dur, kindName, seasons, tmdbImg, hue, finish, cap } from '../lib/format.js';

  const state = { time: 105, mood: 'laugh', kind: 'any' };
  // метка на постере: почему тайтл в подборке
  const WHY: Record<string, string> = { gem: 'Находка', classic: 'Классика', taste: 'По вашему вкусу' };
  try { Object.assign(state, JSON.parse(sessionStorage.getItem('knv-pick') || '{}')); } catch {}
  let list = [];
  const $ = (id) => document.getElementById(id)!;

  // слово во фразе: изменённое перелистывается снизу вверх, как на табло
  function put(id: string, word: string, changed: string) {
    const el = $(id).querySelector<HTMLElement>('.slot-w')!;
    if (id !== changed) { if (el.textContent !== word) el.textContent = word; return; }
    el.innerHTML = `<span class="sv">${word}</span>`;
  }

  function label(changed = '') {
    put('s-time', TIMES.find((t) => t.v === state.time)!.word, changed);
    put('s-mood', state.mood === 'any' ? 'чего угодно' : MOODS.find((m) => m.v === state.mood)!.word, changed);
    put('s-kind', KINDS.find((k) => k.v === state.kind)!.word, changed);
    document.querySelectorAll<HTMLButtonElement>('.opt[data-time]').forEach((b) => b.setAttribute('aria-selected', String(+b.dataset.time! === state.time)));
    document.querySelectorAll<HTMLButtonElement>('.opt[data-mood]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.mood === state.mood)));
    document.querySelectorAll<HTMLButtonElement>('.opt[data-kind]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.kind === state.kind)));
  }

  async function update() {
    const all = await loadIndex();
    const prof = profile(new Map(all.map((f) => [f.id, f])));
    // 12 карточек — смесь находок, свежего, классики и (с историей) того, что по вкусу; остальное — следом
    const matched = all.filter((f) => matches(f, state));
    const { items, rest } = curate(matched, { time: state.time, mood: state.mood, prof, day: new Date().toDateString() });
    list = [...items.map((x) => x.f), ...rest];
    const forms = KINDS.find((k) => k.v === state.kind)!.forms;
    $('tonight-n').textContent = list.length ? list.length.toLocaleString('ru-RU') + ' ' + plural(list.length, ...forms) + (prof.n ? ' · с учётом ваших вкусов' : '') : '';
    $('tonight').innerHTML = list.length
      ? items.map((x, i) => cardHTML(x.f, base, { i, why: WHY[x.why], time: state.time })).join('')
      : '<div class="empty"><h2>Под такой вечер ничего нет</h2><p>Дайте себе чуть больше времени или выберите другое настроение.</p></div>';
    renderPop(); // после подборки: популярное не повторяет то, что уже в ней
    const q = new URLSearchParams({ time: String(state.time), mood: state.mood });
    $('tonight-all').setAttribute('href', `${base}${state.kind === 'series' ? 'serialy' : 'filmy'}/?${q}`);
    // выбор дня: меняется в полночь, при тех же фильтрах весь день один и тот же
    pool = matched;
    daily = dailyPick(matched, { ...state, prof, watch: watchlist() });
    dailyLabel = prof.n ? 'Выбор на сегодня — по вашим вкусам' : 'Выбор на сегодня';
    showPick(daily, dailyLabel, false);
  }

  // карточка наверху: выбор дня или случайный, если нажали кубик
  function showPick(f: any, l: string, rnd: boolean) {
    ($('pick-card') as HTMLElement).hidden = !f;
    if (!f) return;
    $('pick-l').textContent = l;
    ($('pick-a') as HTMLAnchorElement).href = `${base}${f.k ? 'serial' : 'film'}/${f.slug}/`;
    $('pick-t').textContent = f.t;
    $('pick-m').textContent = f.k ? `${kindName(f)} · ${seasons(f)} · серия ${dur(f.min)}` : `${f.y} · ${dur(f.min)} · IMDb ${f.imdb.toFixed(1)}`;
    // время финала меняем в том же элементе — тогда цифры перещёлкиваются, а не появляются заново
    const e = finish(f, state.time)!; // время на главной задано всегда
    $('pick-pre').textContent = cap(e.text);
    ($('pick-e').querySelector('[data-end]') as HTMLElement).dataset.end = String(e.min);
    $('pick-poster').innerHTML = f.p ? `<img src="${tmdbImg(f.p, 200)}" alt="" onerror="knvImg(this)">` : '';
    $('pick-poster').style.setProperty('--h', String(hue(f.id)));
    $('pick-n').hidden = rnd;
    $('pick-back').hidden = !rnd;
    $('dice-t').textContent = rnd ? 'Ещё случайный' : 'Не то? Случайный';
  }

  // кубик: случайный хороший тайтл под ту же фразу — время, настроение, фильм или сериал.
  // От 7 на IMDb, от 25 тыс. оценок, с русским названием; недавно выпавшие не повторяются.
  let daily: any = null, dailyLabel = '', pool: any[] = [], rolling = false;
  const recent: string[] = [];
  async function roll() {
    if (rolling) return;
    const docOk = (f: any) => !f.genres.includes('документальный') || state.mood === 'think' || state.mood === 'inspire';
    let cand = pool.filter((f) => f.imdb >= 7 && f.v >= 25000 && /[а-яё]/i.test(f.t) && docOk(f) && f !== daily);
    if (!cand.length) cand = pool.filter((f) => f !== daily);
    const fresh = cand.filter((f) => !recent.includes(f.id));
    if (fresh.length) cand = fresh;
    const f = cand[Math.floor(Math.random() * cand.length)];
    if (!f) return;
    recent.push(f.id); if (recent.length > 30) recent.shift();
    const card = $('pick-card'), dice = $('dice'), t = $('pick-t');
    card.classList.remove('done'); dice.classList.remove('roll'); void dice.offsetWidth; dice.classList.add('roll');
    // барабан: постеры прокручиваются и останавливаются на выпавшем, название меняется вместе с ними
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      rolling = true;
      card.classList.add('spin');
      const others = cand.filter((x) => x !== f).sort(() => Math.random() - 0.5);
      const reel = [...others.filter((x) => x.p), ...others.filter((x) => !x.p)].slice(0, 11).concat(f);
      const n = reel.length, TIME = 1400;
      $('pick-poster').innerHTML = `<span class="reel" style="--n:${n};--t:${TIME}ms">${reel.map((x) =>
        `<span class="reel-i" style="--h:${hue(x.id)}">${x.p ? `<img src="${tmdbImg(x.p, 200)}" alt="" onerror="knvImg(this)">` : ''}<span class="ph" aria-hidden="true">${x.t.replace(/[<>&]/g, '')}</span></span>`).join('')}</span>`;
      // барабан тормозит, как кривая анимации: i-й постер в центре примерно в момент 1 − (1 − i/(n−1))^¼
      const t0 = performance.now();
      await new Promise<void>((done) => {
        let i = 0;
        const step = () => {
          const k = (performance.now() - t0) / TIME;
          while (i < n - 1 && k >= 1 - Math.pow(1 - (i + 0.5) / (n - 1), 0.25)) i++;
          t.textContent = reel[i].t;
          if (k < 1) requestAnimationFrame(step); else done();
        };
        requestAnimationFrame(step);
      });
      card.classList.remove('spin');
      rolling = false;
    }
    const mw = MOODS.find((m) => m.v === state.mood);
    showPick(f, mw ? `Случайный выбор — ${mw.word}` : 'Случайный выбор', true);
    void card.offsetWidth; card.classList.add('done');
  }

  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button');
    if (!b) return;
    const d = b.dataset;
    let changed = '';
    if (d.time) { state.time = +d.time; changed = 's-time'; }
    else if (d.mood) { state.mood = d.mood; changed = 's-mood'; }
    else if (d.kind) { state.kind = d.kind; changed = 's-kind'; }
    else if (d.menu) { menuSlot === b ? closeMenu(true) : openMenu(b); return; }
    else if (d.tab) {
      popTab = d.tab;
      document.querySelectorAll<HTMLElement>('[data-tab]').forEach((t) => t.setAttribute('aria-pressed', String(t === b)));
      renderPop();
      return;
    } else if (b.id === 'dice') { roll(); return; }
    else if (b.id === 'pick-back') { showPick(daily, dailyLabel, false); return; }
    else return;
    try { sessionStorage.setItem('knv-pick', JSON.stringify(state)); } catch {}
    closeMenu(true);
    label(changed);
    update();
  });

  // меню выделенного слова: открывается под словом, стрелки ходят по вариантам, Esc закрывает
  let menuSlot: HTMLElement | null = null;
  function openMenu(slot: HTMLElement) {
    closeMenu(false);
    const m = $(slot.dataset.menu!), host = slot.closest('.hero-main')!.getBoundingClientRect(), r = slot.getBoundingClientRect();
    m.hidden = false;
    m.style.left = Math.max(0, Math.min(r.left - host.left, host.width - m.offsetWidth)) + 'px';
    m.style.top = r.bottom - host.top + 8 + 'px';
    slot.setAttribute('aria-expanded', 'true');
    menuSlot = slot;
    (m.querySelector<HTMLElement>('[aria-selected="true"]') || m.querySelector<HTMLElement>('.opt'))!.focus();
  }
  function closeMenu(focusSlot: boolean) {
    if (!menuSlot) return;
    $(menuSlot.dataset.menu!).hidden = true;
    menuSlot.setAttribute('aria-expanded', 'false');
    if (focusSlot) menuSlot.focus();
    menuSlot = null;
  }
  document.addEventListener('pointerdown', (e) => {
    if (menuSlot && !(e.target as HTMLElement).closest('.menu, .slot')) closeMenu(false);
  });
  document.querySelectorAll<HTMLElement>('.menu').forEach((m) => m.addEventListener('keydown', (e) => {
    const opts = [...m.querySelectorAll<HTMLElement>('.opt')], i = opts.indexOf(document.activeElement as HTMLElement);
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') { e.preventDefault(); opts[(i + (e.key === 'ArrowDown' ? 1 : opts.length - 1)) % opts.length].focus(); }
    else if (e.key === 'Escape') { e.preventDefault(); closeMenu(true); }
    else if (e.key === 'Tab') closeMenu(false);
  }));

  // «Популярное сейчас»: только активная вкладка, без того, что уже есть в «Подходит на сегодня»
  let popTab = 'all';
  async function renderPop() {
    const all = await loadIndex();
    const shown = new Set([...document.querySelectorAll<HTMLElement>('#tonight .card')].map((c) => c.dataset.id!));
    const kind = popTab === 'all' ? 'any' : popTab;
    $('pop').innerHTML = popularNow(all, { kind, exclude: shown }).map((f, i) => cardHTML(f, base, { i })).join('');
  }

  // разделы поднимаются и проявляются один раз, когда доходят до экрана
  const seen = new IntersectionObserver((es) => es.forEach((e) => {
    if (e.isIntersecting) { e.target.classList.add('in'); seen.unobserve(e.target); }
  }), { rootMargin: '0px 0px -10% 0px' });
  document.querySelectorAll('.reveal').forEach((el) => seen.observe(el));


  // плитки подборок наклоняются вслед за курсором — только с мышью и если анимация не отключена
  if (matchMedia('(hover: hover) and (pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLElement>('.coll').forEach((c) => {
      c.addEventListener('pointermove', (e) => {
        const r = c.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5, y = (e.clientY - r.top) / r.height - 0.5;
        c.style.transform = `perspective(800px) rotateX(${(-y * 8).toFixed(2)}deg) rotateY(${(x * 10).toFixed(2)}deg) translateY(-4px)`;
      });
      c.addEventListener('pointerleave', () => (c.style.transform = ''));
    });
  }



  label();
  update();
</script>
